from google.colab import drive
drive.mount('/content/drive')

import pandas as pd
import glob
import os

data_path = '/content/drive/MyDrive/data' 
os.chdir(data_path)

files = glob.glob("*.csv")  
df_list = [pd.read_csv(f) for f in files]

merged_df = pd.concat(df_list, ignore_index=True)

merged_df = merged_df.drop_duplicates(subset='text')

label_map = {'기쁨':0, '당황':1, '분노':2, '불안':3, '상처':4, '슬픔':5}
merged_df['label_num'] = merged_df['label'].map(label_map)

print("총 데이터 개수:", len(merged_df))
print(merged_df.head())
print(merged_df['label'].value_counts())

merged_df.to_csv("emotion_dataset.csv", index=False, encoding='utf-8-sig')
print("emotion_dataset.csv 파일 생성 완료!")
